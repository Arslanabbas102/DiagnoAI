# Copy this file to .env and fill in the values
PORT=5000
MONGO_URL=mongodb://localhost:27017/diagnoai
JWT_SECRET_KEY=change-me-to-a-long-random-string
CLIENT_SITE_URL=http://localhost:5173

# Python interpreter used to run the AI models (Python 3.7 virtualenv)
PYTHON=.venv/bin/python

# Optional: Stripe payments for appointment booking
STRIPE_SECRET_KEY=

# Optional: Gmail address + app password used to send contact and password-reset emails
EMAIL_USER=
APP_PASS=
# Optional: where contact-form messages are delivered (defaults to EMAIL_USER)
CONTACT_TO=
